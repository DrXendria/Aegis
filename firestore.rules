rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures
    // for the Aegis Zero-Knowledge Password Manager (V2 schema):
    //
    // Collection: vaults
    // Document ID: {userId} (matches Firebase Auth UID)
    // Fields (all optional to support partial merge updates):
    //   - userName: string (optional, length <= 100) - User display name
    //   - baseCurrency: string (optional, length 1..10) - Preferred currency code
    //   - language: string (optional, length 1..15) - Preferred UI locale/language
    //   - customCategories: list (optional, size <= 100) - User-defined categories
    //   - migratedV2: bool (optional) - Flag indicating V2 subcollection migration
    //   - updatedAt: int (optional) - Last update epoch timestamp (ms)
    //
    // Subcollection: vaults/{userId}/entries
    // Document ID: {entryId}
    // Fields (all required):
    //   - v: int (required, must equal 2) - Encryption envelope version
    //   - ciphertext: string (required, length 1..500000) - Client-side encrypted payload
    //   - iv: string (required, length 1..100) - Initialization vector
    //   - updatedAt: int (required) - Last update epoch timestamp (ms)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the path-scoped resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate that the document contains all required fields
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate an optional string field with minimum and maximum length bounds
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        (data[field] is string &&
         data[field].size() >= minLen &&
         data[field].size() <= maxLen);
    }

    // Validate a list with a maximum element count
    function isValidList(listVal, maxSize) {
      return listVal is list && listVal.size() <= maxSize;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidVaultSettings(data) {
      return hasOnlyAllowedFields(data, [
               'userName',
               'baseCurrency',
               'language',
               'customCategories',
               'migratedV2',
               'updatedAt'
             ]) &&
             isValidOptionalString(data, 'userName', 0, 100) &&
             isValidOptionalString(data, 'baseCurrency', 1, 10) &&
             isValidOptionalString(data, 'language', 1, 15) &&
             (!('customCategories' in data) || isValidList(data.customCategories, 100)) &&
             (!('migratedV2' in data) || data.migratedV2 is bool) &&
             (!('updatedAt' in data) || data.updatedAt is int);
    }

    function isValidEncryptedEntry(data) {
      return hasOnlyAllowedFields(data, ['v', 'ciphertext', 'iv', 'updatedAt']) &&
             hasRequiredFields(data, ['v', 'ciphertext', 'iv', 'updatedAt']) &&
             data.v is int &&
             data.v == 2 &&
             data.ciphertext is string &&
             data.ciphertext.size() > 0 &&
             data.ciphertext.size() <= 500000 &&
             data.iv is string &&
             data.iv.size() > 0 &&
             data.iv.size() <= 100 &&
             data.updatedAt is int;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Root vault settings document: strictly owner-only, no collection listing, no client deletion
    match /vaults/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidVaultSettings(request.resource.data);
      allow update: if isOwner(userId) && isValidVaultSettings(request.resource.data);
      allow delete: if false;

      // Encrypted vault entries subcollection: strictly owner-only with strict V2 schema validation
      match /entries/{entryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEncryptedEntry(request.resource.data);
        allow update: if isOwner(userId) && isValidEncryptedEntry(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Default deny catch-all for all other collections and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
